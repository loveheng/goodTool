<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 高德 Web 服务（geo 域 geocode/reverse/search_poi/route/static_map）：
         经 lib/service/amap_http_provider.dart 出网，无此权限 HTTP 请求直接失败。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 系统日历源（calendar_query source: system，P2-⑦）：经 lib/service/
         system_calendar_port.dart 的 MethodChannel 读 CalendarContract；
         运行时未授权 → Kotlin 侧 PERMISSION_DENIED → Dart ERR_CALENDAR_PERMISSION
         （fail-closed，不返回空列表假装无日程）。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>

    <!-- 定位权限（geo 域「当前定位/指南针」经 LocationSensorProvider 平台实现；
         真实传感器实现（geolocator）接入时运行时授权由系统弹窗触发，
         缺权限时内核 fail-closed 返 PERMISSION_DENIED，不返回伪造坐标）。
         网络出图（高德 REST + 画布 XYZ 瓦片）只需 INTERNET，勿删。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- goodhub 本地 Binder 插件契约（thirdconnect.md §1.2.2 / §9.3）：本插件以
         `McpBinderService`（action=`com.zzh.goodhub.action.MCP_SERVER` + meta-data
         SERVER_ID/SERVER_TITLE 暴露）供宿主跨 app bind。bind 受 `signature` 权限护门，
         该权限**必须被某同签名 app 声明**才可被宿主授予——此处防御性声明一次：即使宿主
         侧漏声明，本 app 安装后权限即入系统，同签名宿主可自动获权（signature 权限对同签名
         应用自动授予）。宿主侧须同款声明且两 app 同签名（见 goodhub 宿主 Manifest）。 -->
    <permission
        android:name="com.zzh.goodhub.permission.MCP_SERVER"
        android:protectionLevel="signature" />

    <application
        android:label="goodTools"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task 前台服务（勿改名） -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- goodhub 本地 Binder 插件服务（goodhub-local-plugin 终点，thirdconnect.md §1.2.2）：
             exported=true 必须（宿主跨 app bind）；signature 权限护门（B2）；
             发现靠 intent action + SERVER_ID/SERVER_TITLE meta-data（§9.3 非包名约定）。
             新 app 接入时改 SERVER_ID/SERVER_TITLE 为自己的标识。 -->
        <service
            android:name="com.goodhub.goodtools.McpBinderService"
            android:exported="true"
            android:permission="com.zzh.goodhub.permission.MCP_SERVER">
            <intent-filter>
                <action android:name="com.zzh.goodhub.action.MCP_SERVER" />
            </intent-filter>
            <meta-data
                android:name="com.zzh.goodhub.SERVER_ID"
                android:value="goodtools" />
            <meta-data
                android:name="com.zzh.goodhub.SERVER_TITLE"
                android:value="GoodTools" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
